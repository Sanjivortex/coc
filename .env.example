# Clash of Clans API key from https://developer.clashofclans.com
# Keys are locked to IP addresses: add your server's public IP when creating the key.
COC_API_TOKEN=

# Hosting without a fixed IP (Vercel, Netlify, …)? Use RoyaleAPI's proxy instead
# and create the key for IP 45.79.218.79:
# COC_API_BASE=https://cocproxy.royaleapi.dev/v1

# Telegram builder alerts (deploy/setup-vps.sh fills these in). Player tag without '#'.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_PLAYER_TAG=9Y9PGP9VP
# ALERT_LEAD_MINUTES=10
# ALERT_TIMEZONE=Asia/Kolkata
